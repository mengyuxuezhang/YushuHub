AI_ADMIN_HOST=127.0.0.1
AI_ADMIN_PORT=7077
AI_ADMIN_USER=admin
AI_ADMIN_PASSWORD=change-me-before-run

AI_DB_HOST=127.0.0.1
AI_DB_PORT=3306
AI_DB_USER=agent_ai
AI_DB_PASSWORD=change-me-before-run
AI_DB_NAME=agent_ai

# 中央构建节点使用独立凭据；此文件只记录受控身份文件路径，不写 Token。
AI_WORKER_IDENTITIES_FILE=
# 迁移兼容：只有显式列出的节点可使用旧 Token；配置身份文件后不再回退。
AI_WORKER_TOKEN=
AI_WORKER_LEGACY_IDS=
# Official build center only: first fresh, idle and version-compatible worker claims first.
AI_WORKER_PRIORITY=
# Official build center only: retired workers remain visible but can never claim.
AI_WORKER_DISABLED=

AI_ADMIN_PUBLIC_URL=https://example.com
# Optional. Defaults to the upgrade-safe persistent directory data/uploads.
AI_UPLOAD_DIR=
# Optional. Defaults to the upgrade-safe persistent directory data/custom-homepage.
AI_CUSTOM_HOMEPAGE_ROOT=
# Official build-center public URL shown in supplier deployment configs generated by the admin UI.
# Usually this is the same as AI_ADMIN_PUBLIC_URL on the official center deployment.
AI_BUILD_CENTER_PUBLIC_URL=https://example.com
# Official center only: enable the "供应商接入" page that issues Supplier ID/Token credentials.
# Supplier deployments should leave this disabled.
AI_CENTER_SUPPLIER_MANAGEMENT=0
AI_UPDATE_ROOT=/www/wwwroot/agent-update/ai
AI_UPDATE_BASE_URL=https://example.com/updates/ai
AI_PREVIEW_ROOT=/www/wwwroot/agent-update/ai-staging
AI_PREVIEW_BASE_URL=https://example.com/updates/ai-staging

# Optional for supplier deployments: submit build tasks to the Agent official build center.
# These can be left empty during first deploy, then configured in the admin UI:
# 平台设置 -> 官方构建中心 -> 校验连接 -> 保存接入配置.
AI_BUILD_CENTER_URL=
AI_BUILD_CENTER_TOKEN=
AI_BUILD_CENTER_SUPPLIER_ID=

# Optional: latest Agent Desktop Next source version available for AI builds.
# Leave AI_SOURCE_VERSION empty to read it from AI_SOURCE_VERSION_URL automatically.
AI_SOURCE_VERSION=
AI_SOURCE_VERSION_URL=https://updates.okpa.cn/agent/next-source/latest.json

# Optional: AI Admin self-update feed provided by Agent release server.
AI_ADMIN_UPDATE_MANIFEST_URL=https://updates.okpa.cn/agent/ai-admin/latest.json
AI_ADMIN_PM2_NAME=agent-ai-admin
AI_ADMIN_PM2_BIN=pm2
AI_ADMIN_NPM_BIN=npm

# Official image upload service used by project branding and market assets.
AI_BRAND_ASSET_IMAGE_BED_UPLOAD_URL=https://assets.okpa.cn/upload
