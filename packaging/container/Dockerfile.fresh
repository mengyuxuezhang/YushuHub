# Build only on the release builder with a curated context, never on the agent host.
FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8 AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/mengyuxuezhang/YushuHub" org.opencontainers.image.revision="$SOURCE_REVISION"
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY --chown=node:node . ./
RUN mkdir -p data logs published && chown node:node data logs published
ENV NODE_ENV=production AI_ADMIN_DEPLOYMENT_MODE=docker
USER node
STOPSIGNAL SIGTERM
ENTRYPOINT ["node", "packaging/container/fresh-entrypoint.mjs"]
